{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "android",
  "include-component-in-tag": false,
  "changelog-sections": [
    { "type": "feat", "section": "Adicionado", "hidden": false },
    { "type": "fix", "section": "Corrigido", "hidden": false },
    { "type": "chore", "section": "Manutenção", "hidden": false },
    { "type": "docs", "section": "Documentação", "hidden": false },
    { "type": "refactor", "section": "Refatorado", "hidden": false },
    { "type": "perf", "section": "Performance", "hidden": false },
    { "type": "test", "section": "Testes", "hidden": false },
    { "type": "ci", "section": "CI/CD", "hidden": false },
    { "type": "build", "section": "Build", "hidden": false }
  ],
  "packages": {
    ".": {
      "release-type": "android"
    }
  }
}